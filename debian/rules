#!/usr/bin/make -f

%:
	dh $@

# Use Debian's Perl directories without local installation records.
override_dh_auto_configure:
	dh_auto_configure -- INSTALLDIRS=vendor NO_PACKLIST=1 NO_PERLLOCAL=1

# Expose the configuration command inside the Webmin module.
override_dh_auto_install:
	dh_auto_install
	mkdir -p debian/cloudmin-config/usr/share/webmin/server-manager
	ln -s /usr/bin/cloudmin-config-system debian/cloudmin-config/usr/share/webmin/server-manager/config-system.pl
